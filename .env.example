# LLM Provider Configuration (e.g. openai, bedrock, github-models)
LLM_PROVIDER=

# Common Settings
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_MS=60000

# OpenAI Configuration
LLM_OPENAI_API_KEY=
LLM_OPENAI_API_URL=
